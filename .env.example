# ==============================================================================
# SAV-SCC, SU, LDA. — Variáveis de Ambiente para o Formulário de Contactos
# ==============================================================================
# Estas variáveis devem ser configuradas no painel da Vercel (Project Settings > Environment Variables)
# ou num ficheiro local .env para testes de desenvolvimento.
# ==============================================================================

# Destinatário oficial dos pedidos de reunião
CONTACT_DESTINATION_EMAIL=savscclda@gmail.com

# Opção 1: Serviço Resend (Recomendado para Vercel — https://resend.com)
# Obtenha uma chave API gratuita em resend.com e insira aqui:
RESEND_API_KEY=re_sua_chave_aqui
RESEND_FROM_EMAIL=SAV-SCC Website <onboarding@resend.dev>

# Opção 2: Webhook Oficial (ex.: Zapier, Make, Slack, CRM)
# Se preferir receber diretamente num canal ou webhook, descomente e preencha:
# CONTACT_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxx/yyyy
